{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/product", "destination": "/product/index.html" },
    { "source": "/founders", "destination": "/founders/index.html" },
    { "source": "/support", "destination": "/support/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/assumption-of-risk", "destination": "/assumption-of-risk/index.html" },
    { "source": "/health-safety", "destination": "/health-safety/index.html" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
